+        JAGGED("Jagged", "攻击伤害", 0.02, Attributes.ATTACK_DAMAGE, UUID.fromString("a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d")),
+        SPIKED("Spiked", "攻击伤害", 0.04, Attributes.ATTACK_DAMAGE, UUID.fromString("b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e")),
+        ANGRY("Angry", "攻击伤害", 0.06, Attributes.ATTACK_DAMAGE, UUID.fromString("c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f")),
+        MENACING("Menacing", "攻击伤害", 0.08, Attributes.ATTACK_DAMAGE, UUID.fromString("d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a")),
+        BRISK("Brisk", "速度", 0.01, Attributes.MOVEMENT_SPEED, UUID.fromString("e5f6a7b8-c9d0-1e2f-3a4b-5c6d7e8f9a0b")),
+        FLEETING("Fleeting", "速度", 0.02, Attributes.MOVEMENT_SPEED, UUID.fromString("f6a7b8c9-d0e1-2f3a-4b5c-6d7e8f9a0b1c")),
+        HASTY("Hasty", "速度", 0.03, Attributes.MOVEMENT_SPEED, UUID.fromString("a7b8c9d0-e1f2-3a4b-5c6d-7e8f9a0b1c2d")),
+        QUICK("Quick", "速度", 0.04, Attributes.MOVEMENT_SPEED, UUID.fromString("b8c9d0e1-f2a3-4b5c-6d7e-8f9a0b1c2d3e")),
+        WILD("Wild", "攻击速度", 0.02, Attributes.ATTACK_SPEED, UUID.fromString("c9d0e1f2-a3b4-5c6d-7e8f-9a0b1c2d3e4f")),
+        RASH("Rash", "攻击速度", 0.04, Attributes.ATTACK_SPEED, UUID.fromString("d0e1f2a3-b4c5-6d7e-8f9a-0b1c2d3e4f5a")),
+        INTREPID("Intrepid", "攻击速度", 0.06, Attributes.ATTACK_SPEED, UUID.fromString("e1f2a3b4-c5d6-7e8f-9a0b-1c2d3e4f5a6b")),
+        VIOLENT("Violent", "攻击速度", 0.08, Attributes.ATTACK_SPEED, UUID.fromString("f2a3b4c5-d6e7-8f9a-0b1c-2d3e4f5a6b7c"));
+
+        final String displayName;
+        final String chineseName;
+        final double value;
+        final Attribute attribute;
+        final UUID uuid;
+
+        Modifier(String displayName, String chineseName, double value, Attribute attribute, UUID uuid) {
+            this.displayName = displayName;
+            this.chineseName = chineseName;
+            this.value = value;
+            this.attribute = attribute;
+            this.uuid = uuid;
+        }
+    }
+
+}
