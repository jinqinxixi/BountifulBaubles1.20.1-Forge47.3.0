+        HEARTY("Hearty", "生命值", 2.0, Attributes.MAX_HEALTH, UUID.fromString("b4d5e6f7-a8b9-0c1d-2e3f-4a5b6c7d8e9f")),
+        HARD("Hard", "盔甲值", 1.0, Attributes.ARMOR, UUID.fromString("c5e6f7a8-b9c0-d1e2-f3a4-b5c6d7e8f9a0")),
